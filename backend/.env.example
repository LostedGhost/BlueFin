APP_NAME="Bluefin Immo"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://api.bluefin-immo.com

APP_LOCALE=fr
APP_FALLBACK_LOCALE=fr

LOG_CHANNEL=stack
LOG_LEVEL=error

# Base de données (MySQL recommandé en production ; SQLite utilisable en local)
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
QUEUE_CONNECTION=database
CACHE_STORE=database

# Le frontend (bluefin-immo.com, sur Vercel) et l'API (api.bluefin-immo.com, sur
# Hostinger) sont deux sous-domaines distincts ; src/services/api.ts (frontend)
# utilise withCredentials: true avec le cookie CSRF de Sanctum, donc le cookie de
# session doit être partagé au niveau du domaine parent et envoyé en cross-site.
SESSION_DOMAIN=.bluefin-immo.com
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=none

# Sanctum — domaines autorisés à recevoir le cookie de session (frontend)
SANCTUM_STATEFUL_DOMAINS=bluefin-immo.com,www.bluefin-immo.com

# ---------------------------------------------------------------------------
# Cloudinary — stockage des fichiers envoyés par les utilisateurs
#
# INDISPENSABLE EN PRODUCTION. Sans ces valeurs, les photos retombent sur le
# disque local, à l'intérieur du répertoire de l'application : elles
# disparaissent alors au premier redéploiement. C'est exactement ce qui est
# arrivé aux photos de logements.
#
# Les mêmes identifiants servent au script tools/migrate-photos-to-cloudinary.mjs.
# ---------------------------------------------------------------------------
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=bluefin

# Connexion avec Google : Client ID de type « Application Web » (Google Cloud
# Console > API et services > Identifiants). Le même que VITE_GOOGLE_CLIENT_ID
# côté frontend. Aucun secret n'est nécessaire.
GOOGLE_CLIENT_ID=

# Emplacement des documents sensibles (pièces d'identité) lorsque Cloudinary
# n'est pas configuré. DOIT pointer hors du répertoire de l'application, sinon
# ces documents sont perdus à chaque déploiement.
# Exemple : /home/u381086576/stockage-prive
PRIVATE_STORAGE_ROOT=

# Mobile Money / CinetPay (paiements + versements hôtes)
CINETPAY_API_KEY=
CINETPAY_SITE_ID=

# Twilio (WhatsApp + SMS pour OTP et notifications)
TWILIO_SID=
TWILIO_TOKEN=
TWILIO_WHATSAPP_NUMBER=
TWILIO_PHONE_NUMBER=

# Firebase Cloud Messaging (push notifications)
FCM_SERVER_KEY=

# Email
MAIL_MAILER=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="contact@bluefin-immo.com"
MAIL_FROM_NAME="${APP_NAME}"

# Stripe (préparé mais non branché à un flux réel actuellement)
STRIPE_SECRET=

# Meilisearch (recherche — indexé via Scout mais non branché aux contrôleurs de recherche actuels)
MEILISEARCH_HOST=
MEILISEARCH_KEY=
