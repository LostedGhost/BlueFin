# Modèle de configuration — copier en .env.development ou .env.production et
# renseigner les valeurs réelles. Toutes les variables doivent être préfixées
# VITE_ pour être lues par le frontend (Vite ne bundle que celles-ci).

# ---------------------------------------------------------------------------
# API et environnement
#
# ⚠️ Le suffixe /index.php ci-dessous est un contournement temporaire : sur
# l'hébergement Hostinger actuel, la réécriture d'URL (.htaccess) du
# sous-domaine api.bluefin-immo.com n'est pas appliquée par le serveur (cause
# encore non identifiée côté LiteSpeed/hPanel — le fichier .htaccess du projet
# est correct et fonctionne dès qu'on passe explicitement par /index.php/...).
# Sans ce préfixe, toutes les requêtes API renvoient 404. À retirer une fois
# la réécriture d'URL réparée côté serveur (support Hostinger ou reconfiguration
# du sous-domaine), en même temps que dans backend/.htaccess si besoin.
# ---------------------------------------------------------------------------
VITE_API_URL=https://api.bluefin-immo.com/index.php
VITE_APP_URL=https://bluefin-immo.com
VITE_APP_NAME=Bluefin-Immo
VITE_APP_ENV=production
VITE_CSRF_URL=https://api.bluefin-immo.com/index.php/sanctum/csrf-cookie
VITE_FRONTEND_URL=https://bluefin-immo.com

# ---------------------------------------------------------------------------
# Fedapay (paiement)
# ---------------------------------------------------------------------------
VITE_FEDAPAY_API_URL=https://api.fedapay.com/v1
VITE_FEDAPAY_PAYMENT_PAGE_URL=https://process.fedapay.com
# Clé PUBLIQUE Fedapay (safe à exposer côté client, ce n'est pas la clé secrète)
VITE_FEDAPAY_PUBLIC_KEY=

# ---------------------------------------------------------------------------
# Coordonnées de contact — affichées dans le pied de page et les informations
# légales. Laisser la valeur par défaut du code (voir src/app/config/legalInfo.ts)
# tant qu'aucun vrai numéro/email n'est disponible.
# ---------------------------------------------------------------------------
VITE_CONTACT_PHONE=
VITE_CONTACT_EMAIL=

# ---------------------------------------------------------------------------
# Informations légales — page /entreprise (src/app/pages.tsx, CompanyInfoPage)
#
# Obligatoires pour la conformité à la loi n° 2017-20 portant Code du numérique
# du Bénin (article 328 — obligation générale d'information en commerce
# électronique, et article 501 — identification de l'éditeur d'un service de
# communication au public en ligne). Tant qu'une variable ci-dessous est vide,
# la page affiche "À compléter" pour ce champ plutôt qu'une valeur inventée —
# ne jamais mettre de valeur fictive ici, même à titre temporaire.
# ---------------------------------------------------------------------------

# Nom commercial de l'exploitant (déjà correct par défaut, à ne changer que si besoin)
VITE_LEGAL_ENTITY_NAME=Bluefin Immo

# Forme juridique exacte : SARL, SA, SAS, Entreprise Individuelle, etc.
VITE_LEGAL_FORME_JURIDIQUE=

# Adresse complète du siège social (rue, quartier, ville, pays)
VITE_LEGAL_SIEGE_SOCIAL=

# Numéro d'inscription au Registre du Commerce et du Crédit Mobilier
VITE_LEGAL_RCCM=

# Capital social (montant + devise, ex: "10 000 000 FCFA")
VITE_LEGAL_CAPITAL_SOCIAL=

# Numéro d'Identifiant Fiscal Unique (assujettissement à la TVA)
VITE_LEGAL_IFU=

# Nom du directeur de la publication (article 501)
VITE_LEGAL_DIRECTEUR_PUBLICATION=

# Hébergeur technique du service (fait déjà connu : Hostinger)
VITE_LEGAL_HEBERGEUR=Hostinger
