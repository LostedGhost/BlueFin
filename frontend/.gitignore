# Dependencies
/node_modules
/.pnp
.pnp.js
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/sdks
!.yarn/versions

# Testing
/coverage
/.nyc_output
/.vitest
/vitest.config.*.timestamp

# Production builds
/build
/dist
/.next
/out
/.vercel
/vercel
*.zip

# Environment variables — tout est ignoré sauf le modèle documenté
.env*
!.env.example

# Cache files
/.cache
/.parcel-cache
/.vite
/vite.config.*.timestamp

# Debug logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Editor directories and files
/.idea
/.vscode
/*.suo
/*.ntvs*
/*.njsproj
/*.sln
/*.sw?
.DS_Store
*.swp
*.swo
*~
.bsconfig.json

# TypeScript
*.tsbuildinfo
.next/types

# Misc
/.eslintcache
/.stylelintcache
/.prettiercache

# Optional: Keep lock files (recommended for Vercel)
# yarn.lock
# package-lock.json
# pnpm-lock.yaml
# Secrets / captures de cookies (ne jamais committer)
*cookie*.txt
*csrf*.txt
cookies.txt
-o
*.session

# Notes/audits/plans de travail générés en session — jamais de doc de travail committée,
# seule la vraie documentation projet (README.md, ATTRIBUTIONS.md, guidelines/) doit l'être.
implementation-notes*.md
*-notes.md
audit-*.md
plan-correction-*.md
