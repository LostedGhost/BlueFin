# Identifiants Cloudinary pour tools/migrate-photos-to-cloudinary.mjs
#
# Copier ce fichier en  tools/.env  et y coller les vraies valeurs.
# tools/.env est ignoré par Git : la clé secrète ne doit jamais être commitée.
#
# Où trouver ces trois valeurs : connectez-vous à Cloudinary, ouvrez le
# tableau de bord (Dashboard) — les identifiants de l'environnement y sont
# affichés ensemble : Cloud name, API Key, API Secret. L'API Secret est masqué
# par défaut, il faut cliquer pour le révéler.

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Optionnel — dossier source des photos. Par défaut :
# D:/SolDigit/BlueFin/Bluefin-api/public/storage/properties
# PHOTOS_DIR=
